      "applies_to": {"stages": ["implementation", "validation", "integration", "release"], "consumers": ["agent", "cli", "harness", "adapter"]},
      "sources": [
        {"path": "docs/core/principles.md", "authority_role": "product-seed", "locator": "Principle 11"},
        {"path": "docs/decisions/0009-authority-meta-model-and-semantic-conformance.md", "authority_role": "adr", "locator": "Evidence semantics"}
