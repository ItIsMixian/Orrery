      "mechanical_enforcement": "human-judgment",
      "failure_behavior": "block-write",
      "unknown_behavior": "preserve-unknown",
      "project_fact_boundary": "not-target-project-fact-or-seed"
    },
    {
      "rule_id": "ORR-OP-009",
      "rule_version": 1,
      "message_key": "validation.stage-and-risk-match-evidence",
