      "failure_behavior": "warn-without-escalation",
      "unknown_behavior": "preserve-unknown",
      "project_fact_boundary": "not-target-project-fact-or-seed"
    },
    {
      "rule_id": "ORR-OP-008",
      "rule_version": 1,
      "message_key": "documentation.durable-constraints-use-new-adrs",
      "summary": {
