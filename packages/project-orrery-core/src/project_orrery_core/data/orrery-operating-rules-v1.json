      "applies_to": {"stages": ["bootstrap", "decision", "implementation", "validation", "maintenance"], "consumers": ["agent", "cli", "harness", "observatory"]},
      "sources": [
        {"path": "docs/decisions/0012-document-governance-and-information-lifecycle.md", "authority_role": "adr", "locator": "Decision 2"},
