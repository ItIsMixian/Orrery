        {"path": "docs/decisions/0009-authority-meta-model-and-semantic-conformance.md", "authority_role": "adr", "locator": "Decision 3"},
        {"path": "docs/core/principles.md", "authority_role": "product-seed", "locator": "Principle 6"}
