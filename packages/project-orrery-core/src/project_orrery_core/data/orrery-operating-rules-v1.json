      "rule_id": "ORR-OP-001",
      "rule_version": 1,
      "message_key": "authority.claim-dimensions-stay-independent",
      "summary": {
        "zh-CN": "决定、实现、验证与发布是独立事实；Accepted 不等于 Implemented 或 Validated。",
        "en": "Decision, implementation, validation, and release are independent facts; Accepted is not Implemented or Validated."
      },
      "applies_to": {"stages": ["bootstrap", "decision", "implementation", "validation", "release"], "consumers": ["agent", "cli", "harness", "observatory", "adapter"]},
      "sources": [
        {"path": "docs/decisions/0009-authority-meta-model-and-semantic-conformance.md", "authority_role": "adr", "locator": "Decision 2"},
        {"path": "docs/core/principles.md", "authority_role": "product-seed", "locator": "Principle 3"}
      ],
      "strength": "must",
      "mechanical_enforcement": "enforceable",
      "failure_behavior": "fail-closed-read-only",
      "unknown_behavior": "preserve-unknown",
      "project_fact_boundary": "not-target-project-fact-or-seed"
    },
    {
      "rule_id": "ORR-OP-002",
      "rule_version": 1,
      "message_key": "authority.scope-evidence-and-unknown-are-explicit",
