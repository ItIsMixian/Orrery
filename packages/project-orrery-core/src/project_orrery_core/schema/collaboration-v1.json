{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-orrery-collaboration-v1",
  "title": "Project Orrery provider-neutral collaboration contracts v1",
  "properties": {
    "schema_version": {"const": 1},
    "contract_type": {"type": "string"}
  },
  "oneOf": [
    {"$ref": "#/$defs/worktree_identity"},
    {"$ref": "#/$defs/workstream_session"},
    {"$ref": "#/$defs/scope"},
    {"$ref": "#/$defs/overlap_finding"},
    {"$ref": "#/$defs/integration_report"},
    {"$ref": "#/$defs/subsystem_registry"},
    {"$ref": "#/$defs/adapter_capabilities"},
    {"$ref": "#/$defs/member"},
    {"$ref": "#/$defs/project_mode"},
    {"$ref": "#/$defs/review_package"},
    {"$ref": "#/$defs/review_decision"},
    {"$ref": "#/$defs/closure_record"}
    ,{"$ref": "#/$defs/scope_observation"}
  ],
  "$defs": {
    "worktree_identity": {
      "type": "object",
      "required": [
        "schema_version", "contract_type", "worktree_id", "worktree_path", "git_dir",
        "git_common_dir", "branch", "head", "dirty", "is_primary", "primary_worktree_path",
        "primary_worktree_source", "integration_ref", "integration_oid", "fact_scope",
        "member_id", "host_id", "visibility", "observability"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "worktree-identity"},
        "worktree_id": {"type": "string", "minLength": 1},
        "worktree_path": {"type": "string", "minLength": 1},
        "git_dir": {"type": "string", "minLength": 1},
        "git_common_dir": {"type": "string", "minLength": 1},
        "branch": {"type": ["string", "null"]},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "dirty": {"type": "boolean"},
        "dirty_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dirty_entry_count": {"type": "integer", "minimum": 0},
        "staged_count": {"type": "integer", "minimum": 0},
        "unstaged_count": {"type": "integer", "minimum": 0},
        "untracked_count": {"type": "integer", "minimum": 0},
        "is_primary": {"type": "boolean"},
        "primary_worktree_path": {"type": "string", "minLength": 1},
        "primary_worktree_source": {"enum": ["git-main-worktree", "maintainer-override"]},
        "integration_ref": {"type": "string", "pattern": "^refs/heads/"},
        "integration_oid": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "merge_base": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "ahead": {"type": "integer", "minimum": 0},
        "behind": {"type": "integer", "minimum": 0},
        "fact_scope": {"enum": ["canonical", "candidate", "worktree"]},
        "member_id": {"type": "string", "minLength": 1},
        "host_id": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["canonical", "candidate", "worktree-local", "local-only", "unknown"]},
        "observability": {"enum": ["local", "shared-metadata", "unavailable", "unknown"]}
      },
      "additionalProperties": false
    },
    "workstream_session": {
      "type": "object",
      "required": [
        "schema_version", "contract_type", "project_mode", "workstream_id", "worktree_id",
        "member_id", "host_id", "active_host_id", "branch", "head", "integration_ref",
        "integration_oid", "merge_base", "lifecycle_phase", "runtime_condition", "scope_revision",
        "primary_subsystem_id", "affected_subsystem_ids", "expected_writes", "governing_docs",
        "validation_surfaces", "visibility", "observability", "captured_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "workstream-session"},
        "project_mode": {"enum": ["personal", "team"]},
        "workstream_id": {"type": "string", "minLength": 1},
        "worktree_id": {"type": "string", "minLength": 1},
        "member_id": {"type": "string", "minLength": 1},
        "host_id": {"type": "string", "minLength": 1},
        "active_host_id": {"type": "string", "minLength": 1},
        "platform_session": {
          "type": ["object", "null"],
          "properties": {
            "adapter": {"type": "string", "minLength": 1},
            "session_id": {"type": "string", "minLength": 1}
          },
          "required": ["adapter", "session_id"],
          "additionalProperties": false
        },
        "branch": {"type": ["string", "null"]},
        "head": {"type": "string"},
        "integration_ref": {"type": "string"},
        "integration_oid": {"type": "string"},
        "merge_base": {"type": "string"},
        "dirty_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lifecycle_phase": {"enum": ["created", "investigating", "implementing", "validating", "review-ready", "integrated", "closed"]},
        "runtime_condition": {"enum": ["active", "waiting-for-user", "paused", "blocked-by-conflict", "failed", "offline", "stale-unknown"]},
        "evidence_freshness": {"enum": ["unknown", "current", "stale"]},
        "closure_reason": {"type": ["string", "null"], "enum": ["integrated", "abandoned", "superseded", "duplicate", null]},
        "lifecycle_revision": {"type": "integer", "minimum": 1},
        "last_transition": {
          "type": ["object", "null"],
          "properties": {
            "from_phase": {"enum": ["created", "investigating", "implementing", "validating", "review-ready", "integrated", "closed"]},
            "to_phase": {"enum": ["created", "investigating", "implementing", "validating", "review-ready", "integrated", "closed"]},
            "reason": {"type": "string", "minLength": 1},
            "occurred_at": {"type": "string", "format": "date-time"}
          },
          "required": ["from_phase", "to_phase", "reason", "occurred_at"],
          "additionalProperties": false
        },
        "scope_revision": {"type": "integer", "minimum": 1},
        "primary_subsystem_id": {"type": "string", "minLength": 1},
        "affected_subsystem_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "expected_writes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "governing_docs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "validation_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "visibility": {"enum": ["worktree-local", "local-only", "shared-metadata", "unknown"]},
        "observability": {"enum": ["local", "shared-metadata", "unavailable", "unknown"]},
        "captured_at": {"type": "string", "format": "date-time"}
        ,"scope_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        ,"scope_observation": {"$ref": "#/$defs/scope_observation"}
        ,"findings": {"type": "array", "items": {"$ref": "#/$defs/overlap_finding"}}
        ,"finding_history": {"type": "array", "items": {"$ref": "#/$defs/overlap_finding"}}
        ,"last_scope_expansion": {
          "type": "object",
          "required": ["level", "decision", "reason", "occurred_at"],
          "properties": {
            "level": {"enum": ["l0", "l1", "l2", "l3"]},
            "decision": {"enum": ["recorded", "auto-revised", "confirmed-local", "blocked"]},
            "reason": {"type": "string", "minLength": 1},
            "member_id": {"type": "string", "minLength": 1},
            "occurred_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        }
        ,"review_package_id": {"type": "string", "minLength": 1}
        ,"review_package_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        ,"lineage": {"$ref": "#/$defs/stacked_lineage"}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "schema_version", "contract_type", "workstream_id", "revision", "scope_kind",
        "primary_subsystem_id", "affected_subsystem_ids", "expected_writes", "governing_docs",
        "validation_surfaces", "member_id", "host_id", "visibility", "observability"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "scope"},
        "workstream_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "scope_kind": {"enum": ["mapped", "unmapped", "project-wide"]},
        "primary_subsystem_id": {"type": "string", "minLength": 1},
        "affected_subsystem_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "expected_writes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "governing_docs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "validation_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "member_id": {"type": "string", "minLength": 1},
        "host_id": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["worktree-local", "local-only", "shared-metadata", "unknown"]},
        "observability": {"enum": ["local", "shared-metadata", "unavailable", "unknown"]},
        "lineage": {"$ref": "#/$defs/stacked_lineage"}
      },
      "additionalProperties": false
    },
    "stacked_lineage": {
      "type": "object",
      "required": [
        "lineage_schema_version", "status", "base_workstream_id", "task_base_oid",
        "validated_head"
      ],
      "properties": {
        "lineage_schema_version": {"const": 1},
        "status": {"enum": ["current", "legacy-unknown", "parent-unverified-unknown"]},
        "base_workstream_id": {"type": ["string", "null"]},
        "task_base_oid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "validated_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}
      },
      "additionalProperties": false
    },
    "overlap_finding": {
      "type": "object",
      "required": [
        "schema_version", "contract_type", "finding_id", "kind", "disposition", "severity",
        "workstream_ids", "path_evidence", "authority_surfaces", "validation_surfaces",
        "required_member_ids", "acknowledgements", "member_id", "host_id", "visibility", "observability", "created_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "overlap-finding"},
        "finding_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["direct", "authority", "semantic", "unknown"]},
        "disposition": {"enum": ["open", "acknowledged", "resolved", "stale"]},
        "severity": {"enum": ["l1", "l2", "l3"]},
        "workstream_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "path_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "authority_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "validation_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_member_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "acknowledgements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["member_id", "reason", "scope_revision", "acknowledged_at"],
            "properties": {
              "member_id": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "scope_revision": {"type": "integer", "minimum": 1},
              "acknowledged_at": {"type": "string", "format": "date-time"},
              "finding_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "member_id": {"type": "string", "minLength": 1},
        "host_id": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["worktree-local", "local-only", "shared-metadata", "unknown"]},
        "observability": {"enum": ["local", "shared-metadata", "unavailable", "unknown"]},
        "created_at": {"type": "string", "format": "date-time"}
        ,"finding_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        ,"finding_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        ,"finding_revision": {"type": "integer", "minimum": 1}
        ,"scope_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["workstream_id", "scope_revision", "scope_fingerprint"],
            "properties": {
              "workstream_id": {"type": "string", "minLength": 1},
              "scope_revision": {"type": "integer", "minimum": 1},
              "scope_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        }
        ,"path_provenance": {"type": "array", "items": {"$ref": "#/$defs/path_evidence"}}
        ,"exclusive_resource_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        ,"blocking": {"type": "boolean"}
        ,"acknowledgement_complete": {"type": "boolean"}
        ,"acknowledgement_progress": {"type": "string", "pattern": "^[0-9]+/[0-9]+$"}
        ,"review_ready_blocked": {"type": "boolean"}
        ,"resolution_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "path_evidence": {
      "type": "object",
      "required": ["workstream_id", "path", "sources"],
      "properties": {
        "workstream_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "items": {"enum": ["committed", "staged", "unstaged", "untracked", "expected"]},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "scope_path": {
      "type": "object",
      "required": ["path", "is_pattern", "sources", "authority_surfaces", "subsystem_ids", "exclusive_resource_ids"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "is_pattern": {"type": "boolean"},
        "sources": {
          "type": "array",
          "items": {"enum": ["committed", "staged", "unstaged", "untracked", "expected"]},
          "uniqueItems": true
        },
        "committed_last_oid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "authority_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "subsystem_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "exclusive_resource_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "scope_observation": {
      "type": "object",
      "required": [
        "schema_version", "contract_type", "workstream_id", "worktree_id", "member_id", "host_id",
        "branch", "head", "integration_ref", "integration_oid", "merge_base", "scope_revision",
        "declared_subsystem_ids", "derived_subsystem_ids", "path_entries", "governing_docs",
        "validation_surfaces", "scope_fingerprint", "visibility", "observability", "captured_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "scope-observation"},
        "workstream_id": {"type": "string", "minLength": 1},
        "worktree_id": {"type": "string", "minLength": 1},
        "member_id": {"type": "string", "minLength": 1},
        "host_id": {"type": "string", "minLength": 1},
        "branch": {"type": ["string", "null"]},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "integration_ref": {"type": "string", "minLength": 1},
        "integration_oid": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "merge_base": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "scope_revision": {"type": "integer", "minimum": 1},
        "declared_subsystem_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "derived_subsystem_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "path_entries": {"type": "array", "items": {"$ref": "#/$defs/scope_path"}},
        "governing_docs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "validation_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "scope_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "visibility": {"enum": ["worktree-local", "local-only", "shared-metadata", "unknown"]},
        "observability": {"enum": ["local", "shared-metadata", "unavailable", "unknown"]},
        "captured_at": {"type": "string", "format": "date-time"},
        "lineage": {"$ref": "#/$defs/stacked_lineage"}
      },
      "additionalProperties": false
    },
    "integration_report": {
      "type": "object",
      "required": [
        "schema_version", "contract_type", "report_id", "candidate_head", "target_ref", "target_oid",
        "merge_base", "scope_revision", "finding_ids", "validations", "state_alignment", "result",
        "member_id", "host_id", "visibility", "observability", "generated_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "integration-report"},
        "report_id": {"type": "string", "minLength": 1},
        "candidate_head": {"type": "string"},
        "target_ref": {"type": "string"},
        "target_oid": {"type": "string"},
        "merge_base": {"type": "string"},
        "scope_revision": {"type": "integer", "minimum": 1},
        "finding_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "validations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "result", "evidence_ref", "completed_at"],
            "properties": {
              "command": {"type": "string", "minLength": 1},
              "result": {"enum": ["passed", "failed", "skipped", "unknown"]},
              "evidence_ref": {"type": "string", "minLength": 1},
              "completed_at": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": false
          }
        },
        "state_alignment": {"enum": ["passed", "failed", "unknown"]},
        "result": {"enum": ["ready-for-human-integration", "blocked", "failed", "stale"]},
        "member_id": {"type": "string", "minLength": 1},
        "host_id": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["worktree-local", "local-only", "shared-metadata", "unknown"]},
        "observability": {"enum": ["local", "shared-metadata", "unavailable", "unknown"]},
        "generated_at": {"type": "string", "format": "date-time"}
        ,"strategy": {"enum": ["merge", "rebase"]}
        ,"integration_worktree_clean": {"type": "boolean"}
        ,"merge_result": {"enum": ["passed", "conflicted", "failed"]}
        ,"conflict_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        ,"target_drifted": {"type": "boolean"}
        ,"author_worktree_unchanged": {"type": "boolean"}
        ,"validation_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "review_binding": {
      "type": "object",
      "required": [
        "candidate_head", "target_ref", "target_oid", "merge_base", "scope_revision",
        "scope_fingerprint", "finding_set_hash", "collaboration_schema_id",
        "collaboration_schema_version", "collaboration_schema_hash", "validation_set_hash"
      ],
      "properties": {
        "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "target_ref": {"type": "string", "pattern": "^refs/heads/"},
        "target_oid": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "merge_base": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "scope_revision": {"type": "integer", "minimum": 1},
        "scope_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "finding_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "collaboration_schema_id": {"const": "project-orrery-collaboration-v1"},
        "collaboration_schema_version": {"const": 1},
        "collaboration_schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "validation_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "review_risk": {
      "type": "object",
      "required": [
        "level", "reasons", "required_human_reviewers", "required_approval_capability",
        "non_author_reviewer_required", "ai_counts_as_human_reviewer"
      ],
      "properties": {
        "level": {"enum": ["normal", "elevated", "high"]},
        "reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_human_reviewers": {"type": "integer", "minimum": 1},
        "required_approval_capability": {"enum": ["reviewer", "integrator"]},
        "non_author_reviewer_required": {"type": "boolean"},
        "ai_counts_as_human_reviewer": {"const": false}
      },
      "additionalProperties": false
    },
    "review_package": {
      "type": "object",
      "required": [
        "schema_version", "contract_type", "review_schema_version", "package_id",
        "content_hash", "hash_excludes", "binding", "workstream_id", "author_member_id",
        "author_host_id", "risk", "evidence", "ai_summary", "presentation_order",
        "invalidation_conditions", "validation_fresh_until", "visibility", "observability", "generated_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "review-package"},
        "review_schema_version": {"const": 1},
        "package_id": {"type": "string", "pattern": "^review-[0-9a-f]{24}$"},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_excludes": {
          "type": "array", "items": {"enum": ["package_id", "content_hash"]},
          "minItems": 2, "maxItems": 2, "uniqueItems": true
        },
        "binding": {"$ref": "#/$defs/review_binding"},
        "workstream_id": {"type": "string", "minLength": 1},
        "author_member_id": {"type": "string", "minLength": 1},
        "author_host_id": {"type": "string", "minLength": 1},
        "risk": {"$ref": "#/$defs/review_risk"},
        "evidence": {
          "type": "object",
          "required": [
            "scope", "findings", "finding_history", "changed_paths", "diff_stat",
            "validations", "state_alignment", "adr_alignment", "speculative_integration",
            "evidence_refs", "unknown_boundaries"
          ],
          "properties": {
            "scope": {"$ref": "#/$defs/scope_observation"},
            "findings": {"type": "array", "items": {"$ref": "#/$defs/overlap_finding"}},
            "finding_history": {"type": "array", "items": {"$ref": "#/$defs/overlap_finding"}},
            "changed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "diff_stat": {"type": "string"},
            "validations": {"type": "array", "items": {"type": "object"}},
            "state_alignment": {"type": "object"},
            "adr_alignment": {"type": "object"},
            "speculative_integration": {"$ref": "#/$defs/integration_report"},
            "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "unknown_boundaries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "ai_summary": {
          "type": "object",
          "required": ["status", "authority", "text", "generated_at"],
          "properties": {
            "status": {"enum": ["unavailable", "provided"]},
            "authority": {"const": "derived-non-authoritative"},
            "text": {"type": "string"},
            "generated_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        },
        "presentation_order": {
          "type": "array", "items": {"enum": ["evidence", "ai_summary"]},
          "minItems": 2, "maxItems": 2, "uniqueItems": true
        },
        "invalidation_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "validation_fresh_until": {"type": "string", "format": "date-time"},
        "visibility": {"const": "worktree-local"},
        "observability": {"const": "local"},
        "generated_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "review_decision": {
      "type": "object",
      "required": [
        "schema_version", "contract_type", "decision_schema_version", "decision_id",
        "package_id", "package_content_hash", "action", "actor_id", "actor_kind",
        "actor_is_author", "actor_capabilities", "reason", "evidence_refs", "decided_at",
        "invalidation_conditions", "visibility", "observability"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "review-decision"},
        "decision_schema_version": {"const": 1},
        "decision_id": {"type": "string", "pattern": "^decision-[0-9a-f]{24}$"},
        "package_id": {"type": "string", "pattern": "^review-[0-9a-f]{24}$"},
        "package_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "action": {"enum": ["approve", "request-changes", "hold", "reject"]},
        "actor_id": {"type": "string", "minLength": 1},
        "actor_kind": {"const": "human"},
        "actor_is_author": {"type": "boolean"},
        "actor_capabilities": {"type": "array", "items": {"enum": ["reviewer", "integrator", "admin"]}, "uniqueItems": true},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "decided_at": {"type": "string", "format": "date-time"},
        "invalidation_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "visibility": {"const": "local-only"},
        "observability": {"const": "local"}
      },
      "additionalProperties": false
    },
    "closure_record": {
      "type": "object",
      "required": [
        "schema_version", "contract_type", "closure_schema_version", "closure_id",
        "workstream_id", "candidate_head", "target_ref", "review_target_oid", "final_oid",
        "review_package_id", "review_package_content_hash", "decision_ids", "validation_refs",
        "closure_reason", "actor_id", "closed_at", "storage", "visibility", "observability"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "closure-record"},
        "closure_schema_version": {"enum": [1, 2]},
        "closure_id": {"type": "string", "pattern": "^closure-[0-9a-f]{24}$"},
        "workstream_id": {"type": "string", "minLength": 1},
        "original_workspace_path": {"type": "string", "minLength": 1},
        "workspace_classification": {"enum": ["integrated-closed"]},
        "workspace_classification_label": {"const": "Integrated/Closed"},
        "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "final_head": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "target_ref": {"type": "string", "pattern": "^refs/heads/"},
        "review_target_oid": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "final_oid": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "integration_oid": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "review_package_id": {"type": "string", "pattern": "^review-[0-9a-f]{24}$"},
        "review_package_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decision_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "validation_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "closure_reason": {"const": "integrated"},
        "actor_id": {"type": "string", "minLength": 1},
        "cleanup_operator_id": {"type": "string", "minLength": 1},
        "cleanup_action_log_ref": {"type": "string", "pattern": "^git-private:orrery/closures/actions/closure-[0-9a-f]{24}/$"},
        "actual_cleanup_actions": {"type": "array", "items": {"enum": ["remove-worktree", "delete-local-branch", "delete-remote-branch", "remove-directory"]}, "uniqueItems": true},
        "closed_at": {"type": "string", "format": "date-time"},
        "storage": {"const": "git-private-common"},
        "visibility": {"const": "local-only"},
        "observability": {"const": "local"}
      },
      "allOf": [
        {
          "if": {"properties": {"closure_schema_version": {"const": 2}}},
          "then": {
            "required": [
              "original_workspace_path", "workspace_classification",
              "workspace_classification_label", "final_head", "integration_oid",
              "cleanup_operator_id", "cleanup_action_log_ref", "actual_cleanup_actions"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "subsystem_registry": {
      "type": "object",
      "required": ["schema_version", "contract_type", "source", "reserved_scope_ids", "entries"],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "subsystem-registry"},
        "source": {"const": "AGENTS.md"},
        "reserved_scope_ids": {"type": "array", "items": {"enum": ["unmapped", "project-wide"]}, "uniqueItems": true},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["subsystem_id", "display_name", "state_docs", "authority_docs", "path_patterns"],
            "properties": {
              "subsystem_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
              "display_name": {"type": "string", "minLength": 1},
              "state_docs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
              "authority_docs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "path_patterns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "capability_audit": {
      "type": "object",
      "required": ["actor_id", "action", "capability", "before", "after", "credential_epoch", "occurred_at"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "action": {"enum": ["grant", "revoke", "remove-member"]},
        "capability": {"type": ["string", "null"]},
        "before": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "after": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "credential_epoch": {"type": "integer", "minimum": 1},
        "occurred_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "adapter_capabilities": {
      "type": "object",
      "required": [
        "schema_version", "contract_type", "adapter_id", "platform", "launch", "attach",
        "rebind", "message", "session_identity_source", "requires_product_write_guard",
        "visibility", "observability"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "adapter-capabilities"},
        "adapter_id": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "launch": {"type": "boolean"},
        "attach": {"type": "boolean"},
        "rebind": {"type": "boolean"},
        "message": {"type": "boolean"},
        "session_identity_source": {"enum": ["adapter-provided", "caller-provided", "unavailable"]},
        "requires_product_write_guard": {"const": true},
        "visibility": {"const": "local-only"},
        "observability": {"const": "local"}
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": [
        "schema_version", "contract_type", "member_id", "member_kind", "base_role", "status",
        "capabilities", "credential_epoch", "credential_state", "audit"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "member"},
        "member_id": {"type": "string", "minLength": 1},
        "member_kind": {"const": "human"},
        "base_role": {"const": "member"},
        "status": {"enum": ["active", "removed"]},
        "capabilities": {"type": "array", "items": {"enum": ["reviewer", "integrator", "admin"]}, "uniqueItems": true},
        "credential_epoch": {"type": "integer", "minimum": 1},
        "credential_state": {"enum": ["active", "revoked"]},
        "audit": {"type": "array", "items": {"$ref": "#/$defs/capability_audit"}}
      },
      "additionalProperties": false
    },
    "project_mode": {
      "type": "object",
      "required": [
        "schema_version", "contract_type", "project_mode", "runtime_status", "member_identity",
        "active_network_features", "network_boundaries"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "project-mode"},
        "project_mode": {"enum": ["personal", "team"]},
        "runtime_status": {"enum": ["personal-local-only", "contract-only"]},
        "member_identity": {"enum": ["implicit-local", "explicit-member-required"]},
        "active_network_features": {"type": "array", "maxItems": 0},
        "network_boundaries": {
          "type": "object",
          "required": ["listener", "discovery", "coordinator", "member_authentication", "team_sync", "heartbeat"],
          "properties": {
            "listener": {"const": false},
            "discovery": {"const": false},
            "coordinator": {"const": false},
            "member_authentication": {"const": false},
            "team_sync": {"const": false},
            "heartbeat": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
