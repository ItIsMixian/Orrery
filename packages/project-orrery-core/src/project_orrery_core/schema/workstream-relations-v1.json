{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-orrery.invalid/schema/workstream-relations-v1.json",
  "title": "Project Orrery Workstream Relations v1",
  "oneOf": [
    {"$ref": "#/$defs/relation_record"},
    {"$ref": "#/$defs/relation_graph"},
    {"$ref": "#/$defs/succession_plan"},
    {"$ref": "#/$defs/discovery_plan"},
    {"$ref": "#/$defs/apply_plan"},
    {"$ref": "#/$defs/apply_receipt"},
    {"$ref": "#/$defs/undo_plan"},
    {"$ref": "#/$defs/undo_receipt"},
    {"$ref": "#/$defs/legacy_projection"}
  ],
  "$defs": {
    "relation_type": {"enum": ["derived_from", "depends_on", "absorbs"]},
    "relation_lifecycle": {"enum": ["proposed", "active", "completed", "cancelled", "stale"]},
    "evidence_state": {"enum": ["confirmed", "unknown", "stale", "rejected", "not-applicable"]},
    "head_state": {"enum": ["current", "stale", "unknown"]},
    "node_state": {"enum": ["active", "blocked", "cancelled", "completed", "failed", "inactive", "review-pending", "stale", "unknown"]},
    "lifecycle_phase": {"enum": ["created", "investigating", "implementing", "validating", "review-ready", "integrated", "closed", "unknown"]},
    "runtime_condition": {"enum": ["active", "waiting-for-user", "paused", "blocked-by-conflict", "failed", "offline", "stale-unknown", "unknown"]},
    "closure_reason": {"type": ["string", "null"], "enum": ["integrated", "abandoned", "superseded", "duplicate", null]},
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "workstream_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "source_link": {
      "type": "object", "additionalProperties": false, "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["git-commit", "workstream-session", "scope", "validation", "relation", "other"]},
        "ref": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "status", "source_head_oid", "target_head_oid", "task_base_oid", "source_head_status",
        "target_head_status", "scope_status", "ancestry_status", "dependency_status",
        "ownership_transfer_oid", "ownership_transfer_status", "target_unique_commits_after_base"
      ],
      "properties": {
        "status": {"$ref": "#/$defs/evidence_state"},
        "source_head_oid": {"$ref": "#/$defs/oid"},
        "target_head_oid": {"$ref": "#/$defs/oid"},
        "task_base_oid": {"$ref": "#/$defs/oid"},
        "source_head_status": {"$ref": "#/$defs/head_state"},
        "target_head_status": {"$ref": "#/$defs/head_state"},
        "scope_status": {"$ref": "#/$defs/head_state"},
        "ancestry_status": {"$ref": "#/$defs/evidence_state"},
        "dependency_status": {"$ref": "#/$defs/evidence_state"},
        "ownership_transfer_oid": {"$ref": "#/$defs/oid"},
        "ownership_transfer_status": {"$ref": "#/$defs/evidence_state"},
        "target_unique_commits_after_base": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["kind", "actor_id"],
      "properties": {
        "kind": {"enum": ["human", "tool", "import"]},
        "actor_id": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "relation_record_fields": {
      "type": "object",
      "required": [
        "schema_version", "contract_type", "event_id", "relation_id", "revision", "relation_type",
        "source_workstream_id", "target_workstream_id", "lifecycle", "recorded_at", "actor", "origin",
        "reason", "evidence", "source_links", "writes_performed"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "workstream-relation-record"},
        "event_id": {"$ref": "#/$defs/safe_id"},
        "relation_id": {"$ref": "#/$defs/safe_id"},
        "revision": {"type": "integer", "minimum": 1},
        "relation_type": {"$ref": "#/$defs/relation_type"},
        "source_workstream_id": {"$ref": "#/$defs/workstream_id"},
        "target_workstream_id": {"$ref": "#/$defs/workstream_id"},
        "lifecycle": {"$ref": "#/$defs/relation_lifecycle"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "actor": {"$ref": "#/$defs/actor"},
        "origin": {"enum": ["native", "legacy-session-projection", "discovery"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
        "evidence": {"$ref": "#/$defs/evidence"},
        "source_links": {"type": "array", "items": {"$ref": "#/$defs/source_link"}, "maxItems": 64},
        "writes_performed": {"type": "boolean"}
      }
    },
    "relation_record": {
      "allOf": [{"$ref": "#/$defs/relation_record_fields"}],
      "unevaluatedProperties": false
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": [
        "workstream_id", "status", "session_state", "lifecycle_phase", "runtime_condition",
        "evidence_freshness", "head_oid", "scope_status", "closure_reason",
        "primary_subsystem_id", "affected_subsystem_ids", "visibility", "observability",
        "source_links", "origin"
      ],
      "properties": {
        "workstream_id": {"$ref": "#/$defs/workstream_id"},
        "status": {"$ref": "#/$defs/node_state"},
        "session_state": {"$ref": "#/$defs/head_state"},
        "lifecycle_phase": {"$ref": "#/$defs/lifecycle_phase"},
        "runtime_condition": {"$ref": "#/$defs/runtime_condition"},
        "evidence_freshness": {"$ref": "#/$defs/head_state"},
        "head_oid": {"$ref": "#/$defs/oid"},
        "scope_status": {"$ref": "#/$defs/head_state"},
        "closure_reason": {"$ref": "#/$defs/closure_reason"},
        "primary_subsystem_id": {"$ref": "#/$defs/workstream_id"},
        "affected_subsystem_ids": {"type": "array", "items": {"$ref": "#/$defs/workstream_id"}, "uniqueItems": true},
        "visibility": {"$ref": "#/$defs/workstream_id"},
        "observability": {"$ref": "#/$defs/workstream_id"},
        "source_links": {"type": "array", "items": {"$ref": "#/$defs/source_link"}, "maxItems": 64},
        "origin": {"enum": ["native", "legacy-session-projection", "relation-only", "discovery"]}
      }
    },
    "edge": {
      "allOf": [
        {"$ref": "#/$defs/relation_record_fields"},
        {
          "type": "object", "required": ["effective_active_succession", "evidence_reason_codes"],
          "properties": {
            "effective_active_succession": {"type": "boolean"},
            "evidence_reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "pair_constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["left_workstream_id", "right_workstream_id", "reasons"],
      "properties": {
        "left_workstream_id": {"$ref": "#/$defs/workstream_id"},
        "right_workstream_id": {"$ref": "#/$defs/workstream_id"},
        "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "diagnostic": {
      "type": "object", "required": ["code"],
      "properties": {"code": {"type": "string", "minLength": 1}}
    },
    "relation_graph": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "contract_type", "nodes", "edges", "pair_constraints",
        "active_tip_workstream_ids", "unknown_workstream_ids", "validation", "read_only",
        "writes_performed", "graph_hash"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "workstream-relation-graph"},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "pair_constraints": {"type": "array", "items": {"$ref": "#/$defs/pair_constraint"}},
        "active_tip_workstream_ids": {"type": "array", "items": {"$ref": "#/$defs/workstream_id"}, "uniqueItems": true},
        "unknown_workstream_ids": {"type": "array", "items": {"$ref": "#/$defs/workstream_id"}, "uniqueItems": true},
        "validation": {
          "type": "object", "additionalProperties": false, "required": ["valid", "errors", "warnings"],
          "properties": {
            "valid": {"type": "boolean"},
            "errors": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
            "warnings": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
          }
        },
        "read_only": {"const": true},
        "writes_performed": {"const": false},
        "graph_hash": {"$ref": "#/$defs/hash"},
        "storage": {"const": "git-common-private-append-only"},
        "storage_ref": {"const": "git-common:orrery/workstream-relations"},
        "legacy_projection_included": {"type": "boolean"}
      }
    },
    "pair_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["left_workstream_id", "right_workstream_id", "reason_codes"],
      "properties": {
        "left_workstream_id": {"$ref": "#/$defs/workstream_id"},
        "right_workstream_id": {"$ref": "#/$defs/workstream_id"},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "blocking_dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["relation_id", "source_workstream_id", "target_workstream_id", "evidence_status"],
      "properties": {
        "relation_id": {"$ref": "#/$defs/safe_id"},
        "source_workstream_id": {"$ref": "#/$defs/workstream_id"},
        "target_workstream_id": {"$ref": "#/$defs/workstream_id"},
        "evidence_status": {"$ref": "#/$defs/evidence_state"}
      }
    },
    "succession_plan": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "contract_type", "graph_hash", "active_tip_workstream_ids", "compare_pairs",
        "suppress_direct_pairs", "blocking_dependencies", "unknown_workstream_ids", "pair_policy",
        "read_only", "writes_performed", "destructive_actions"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "workstream-succession-plan"},
        "graph_hash": {"$ref": "#/$defs/hash"},
        "active_tip_workstream_ids": {"type": "array", "items": {"$ref": "#/$defs/workstream_id"}, "uniqueItems": true},
        "compare_pairs": {"type": "array", "items": {"$ref": "#/$defs/pair_decision"}},
        "suppress_direct_pairs": {"type": "array", "items": {"$ref": "#/$defs/pair_decision"}},
        "blocking_dependencies": {"type": "array", "items": {"$ref": "#/$defs/blocking_dependency"}},
        "unknown_workstream_ids": {"type": "array", "items": {"$ref": "#/$defs/workstream_id"}, "uniqueItems": true},
        "pair_policy": {"const": "active-tips-v1"},
        "read_only": {"const": true},
        "writes_performed": {"const": false},
        "destructive_actions": {"type": "array", "maxItems": 0}
      }
    },
    "rejected_hint": {
      "type": "object", "additionalProperties": false,
      "required": ["source_workstream_id", "target_workstream_id", "status", "reason_code"],
      "properties": {
        "source_workstream_id": {"$ref": "#/$defs/workstream_id"},
        "target_workstream_id": {"$ref": "#/$defs/workstream_id"},
        "status": {"const": "unknown"},
        "reason_code": {"const": "branch-or-path-similarity-insufficient-evidence"}
      }
    },
    "discovery_plan": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "contract_type", "graph_hash", "candidates", "rejected_hints",
        "similarity_inference_permitted", "confirmation_required", "confirmation_scope", "silence_policy",
        "writes_performed", "destructive_actions", "plan_id"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "workstream-relation-discovery-plan"},
        "graph_hash": {"$ref": "#/$defs/hash"},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/relation_record"}},
        "rejected_hints": {"type": "array", "items": {"$ref": "#/$defs/rejected_hint"}},
        "similarity_inference_permitted": {"const": false},
        "confirmation_required": {"const": true},
        "confirmation_scope": {"const": "one-local-confirmation-per-exact-plan"},
        "silence_policy": {"const": "no-permanent-suppression"},
        "writes_performed": {"const": false},
        "destructive_actions": {"type": "array", "maxItems": 0},
        "plan_id": {"$ref": "#/$defs/safe_id"}
      }
    },
    "preservation_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["worktrees", "branches", "commits", "validations", "author_documents", "relation_history"],
      "properties": {
        "worktrees": {"const": true}, "branches": {"const": true}, "commits": {"const": true},
        "validations": {"const": true}, "author_documents": {"const": true}, "relation_history": {"const": true}
      }
    },
    "output_contract": {
      "type": "object", "additionalProperties": false, "required": ["contract_type", "required_fields"],
      "properties": {
        "contract_type": {"enum": ["workstream-relation-apply-receipt", "workstream-relation-undo-receipt"]},
        "required_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "session_binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "workstream_id", "session_hash", "session_state", "head_oid", "lifecycle_phase",
        "runtime_condition", "evidence_freshness", "scope_status", "closure_reason"
      ],
      "properties": {
        "workstream_id": {"$ref": "#/$defs/workstream_id"},
        "session_hash": {"$ref": "#/$defs/hash"},
        "session_state": {"const": "current"},
        "head_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "lifecycle_phase": {"$ref": "#/$defs/lifecycle_phase"},
        "runtime_condition": {"$ref": "#/$defs/runtime_condition"},
        "evidence_freshness": {"const": "current"},
        "scope_status": {"const": "current"},
        "closure_reason": {"$ref": "#/$defs/closure_reason"}
      }
    },
    "session_transition": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["lifecycle_phase", "runtime_condition", "evidence_freshness", "closure_reason"],
      "properties": {
        "lifecycle_phase": {"$ref": "#/$defs/lifecycle_phase"},
        "runtime_condition": {"$ref": "#/$defs/runtime_condition"},
        "evidence_freshness": {"$ref": "#/$defs/head_state"},
        "closure_reason": {"$ref": "#/$defs/closure_reason"}
      }
    },
    "takeover_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["relation_id", "target_lifecycle", "predecessor_session", "transition"],
      "properties": {
        "relation_id": {"$ref": "#/$defs/safe_id"},
        "target_lifecycle": {"enum": ["active", "completed"]},
        "predecessor_session": {"$ref": "#/$defs/session_binding"},
        "transition": {"$ref": "#/$defs/session_transition"}
      }
    },
    "append_apply_operation": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "relation_id", "target_lifecycle", "event_hash"],
      "properties": {
        "action": {"const": "append-relation-event"},
        "relation_id": {"$ref": "#/$defs/safe_id"},
        "target_lifecycle": {"$ref": "#/$defs/relation_lifecycle"},
        "event_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "assert_closed_apply_operation": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "relation_id", "workstream_id", "expected_session_hash", "expected_head_oid"],
      "properties": {
        "action": {"const": "assert-predecessor-closed-superseded"},
        "relation_id": {"$ref": "#/$defs/safe_id"},
        "workstream_id": {"$ref": "#/$defs/workstream_id"},
        "expected_session_hash": {"$ref": "#/$defs/hash"},
        "expected_head_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "transition_apply_operation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "action", "relation_id", "workstream_id", "expected_session_hash", "expected_head_oid",
        "expected_lifecycle_phase", "expected_runtime_condition", "expected_evidence_freshness",
        "expected_scope_status", "expected_closure_reason", "target_lifecycle_phase",
        "target_runtime_condition", "target_evidence_freshness", "target_closure_reason",
        "transition_reason", "restore_receipt_required"
      ],
      "properties": {
        "action": {"const": "transition-predecessor-session"},
        "relation_id": {"$ref": "#/$defs/safe_id"},
        "workstream_id": {"$ref": "#/$defs/workstream_id"},
        "expected_session_hash": {"$ref": "#/$defs/hash"},
        "expected_head_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "expected_lifecycle_phase": {"$ref": "#/$defs/lifecycle_phase"},
        "expected_runtime_condition": {"$ref": "#/$defs/runtime_condition"},
        "expected_evidence_freshness": {"$ref": "#/$defs/head_state"},
        "expected_scope_status": {"$ref": "#/$defs/head_state"},
        "expected_closure_reason": {"$ref": "#/$defs/closure_reason"},
        "target_lifecycle_phase": {"$ref": "#/$defs/lifecycle_phase"},
        "target_runtime_condition": {"$ref": "#/$defs/runtime_condition"},
        "target_evidence_freshness": {"$ref": "#/$defs/head_state"},
        "target_closure_reason": {"$ref": "#/$defs/closure_reason"},
        "transition_reason": {"type": "string", "minLength": 1, "maxLength": 512},
        "restore_receipt_required": {"const": true}
      }
    },
    "apply_operation": {
      "oneOf": [
        {"$ref": "#/$defs/append_apply_operation"},
        {"$ref": "#/$defs/assert_closed_apply_operation"},
        {"$ref": "#/$defs/transition_apply_operation"}
      ]
    },
    "apply_plan": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "contract_type", "discovery_plan_id", "graph_hash", "operations", "session_bindings",
        "atomicity", "no_drift_policy",
        "confirmation_required", "confirmation_scope", "output_contract", "preservation_contract",
        "writes_performed", "execution_supported", "destructive_actions", "plan_hash", "plan_id"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "workstream-relation-apply-plan"},
        "discovery_plan_id": {"$ref": "#/$defs/safe_id"},
        "graph_hash": {"$ref": "#/$defs/hash"},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/apply_operation"}},
        "session_bindings": {"type": "array", "items": {"$ref": "#/$defs/takeover_binding"}},
        "atomicity": {"const": "all-operations-or-none"},
        "no_drift_policy": {"const": "exact-graph-session-and-head-or-fail"},
        "confirmation_required": {"const": true},
        "confirmation_scope": {"const": "one-local-confirmation-per-exact-plan"},
        "output_contract": {"$ref": "#/$defs/output_contract"},
        "preservation_contract": {"$ref": "#/$defs/preservation_contract"},
        "writes_performed": {"const": false},
        "execution_supported": {"const": false},
        "destructive_actions": {"type": "array", "maxItems": 0},
        "plan_hash": {"$ref": "#/$defs/hash"},
        "plan_id": {"$ref": "#/$defs/safe_id"}
      }
    },
    "relation_event_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["relation_id", "event_id", "event_hash", "prior_lifecycle", "resulting_lifecycle"],
      "properties": {
        "relation_id": {"$ref": "#/$defs/safe_id"},
        "event_id": {"$ref": "#/$defs/safe_id"},
        "event_hash": {"$ref": "#/$defs/hash"},
        "prior_lifecycle": {"anyOf": [{"$ref": "#/$defs/relation_lifecycle"}, {"type": "null"}]},
        "resulting_lifecycle": {"$ref": "#/$defs/relation_lifecycle"}
      }
    },
    "session_transition_receipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "relation_id", "workstream_id", "original_session_hash", "resulting_session_hash",
        "original_head_oid", "resulting_head_oid", "original_lifecycle_phase", "resulting_lifecycle_phase",
        "original_runtime_condition", "resulting_runtime_condition", "original_evidence_freshness",
        "resulting_evidence_freshness", "original_scope_status", "resulting_scope_status",
        "original_closure_reason", "resulting_closure_reason"
      ],
      "properties": {
        "relation_id": {"$ref": "#/$defs/safe_id"},
        "workstream_id": {"$ref": "#/$defs/workstream_id"},
        "original_session_hash": {"$ref": "#/$defs/hash"},
        "resulting_session_hash": {"$ref": "#/$defs/hash"},
        "original_head_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "resulting_head_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "original_lifecycle_phase": {"$ref": "#/$defs/lifecycle_phase"},
        "resulting_lifecycle_phase": {"$ref": "#/$defs/lifecycle_phase"},
        "original_runtime_condition": {"$ref": "#/$defs/runtime_condition"},
        "resulting_runtime_condition": {"$ref": "#/$defs/runtime_condition"},
        "original_evidence_freshness": {"$ref": "#/$defs/head_state"},
        "resulting_evidence_freshness": {"$ref": "#/$defs/head_state"},
        "original_scope_status": {"$ref": "#/$defs/head_state"},
        "resulting_scope_status": {"$ref": "#/$defs/head_state"},
        "original_closure_reason": {"$ref": "#/$defs/closure_reason"},
        "resulting_closure_reason": {"$ref": "#/$defs/closure_reason"}
      }
    },
    "apply_receipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "contract_type", "receipt_id", "plan_id", "plan_hash", "graph_hash",
        "confirmed_locally", "relation_events", "predecessor_transitions", "writes_performed"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_type": {"const": "workstream-relation-apply-receipt"},
        "receipt_id": {"$ref": "#/$defs/safe_id"},
        "plan_id": {"$ref": "#/$defs/safe_id"},
        "plan_hash": {"$ref": "#/$defs/hash"},
        "graph_hash": {"$ref": "#/$defs/hash"},
        "confirmed_locally": {"const": true},
        "relation_events": {"type": "array", "items": {"$ref": "#/$defs/relation_event_receipt"}},
        "predecessor_transitions": {"type": "array", "items": {"$ref": "#/$defs/session_transition_receipt"}},
        "writes_performed": {"const": true}
      }
    },
    "append_undo_operation": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "relation_id", "expected_event_id", "expected_event_hash", "target_lifecycle"],
      "properties": {
        "action": {"const": "append-compensating-event"},
        "relation_id": {"$ref": "#/$defs/safe_id"},
        "expected_event_id": {"$ref": "#/$defs/safe_id"},
        "expected_event_hash": {"$ref": "#/$defs/hash"},
        "target_lifecycle": {"$ref": "#/$defs/relation_lifecycle"}
      }
    },
    "restore_undo_operation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "action", "relation_id", "workstream_id", "expected_session_hash", "expected_head_oid",
