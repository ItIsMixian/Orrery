    "undo_plan": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "contract_type", "apply_receipt_id", "apply_receipt_hash", "apply_plan_hash",
        "graph_hash", "operations", "atomicity", "no_drift_policy", "confirmation_required",
