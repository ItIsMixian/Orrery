{
  "manifest_format": 1,
  "adapter": {
    "id": "project-orrery-codex",
    "name": "Project Orrery Codex Adapter",
    "platform": "codex",
    "version": "0.1.1",
    "api_version": 1,
    "support_status": "experimental"
  },
  "requires": {
    "core_api": 1,
    "cli": {
      "distribution": "project-orrery-cli",
      "minimum": "0.1.0",
      "maximum_exclusive": "0.2.0",
      "entrypoint": "project-orrery"
    }
  },
  "workstream_capabilities": {
    "schema_version": 1,
    "contract_type": "adapter-capabilities",
    "adapter_id": "project-orrery-codex",
    "platform": "codex",
    "launch": false,
    "attach": true,
    "rebind": false,
    "message": false,
    "session_identity_source": "caller-provided",
    "requires_product_write_guard": true,
    "visibility": "local-only",
    "observability": "local"
  },
  "runtime_compatibility": {
    "runtime": "Codex",
    "status": "verified",
    "verified": [
      {
        "runtime_version": "codex-cli 0.148.0-alpha.21",
        "desktop_version": "26.818.2441.0",
        "os": "Windows 11 Pro x64 10.0.26200 (build 26200)",
        "adapter_version": "0.1.0",
        "core_version": "0.1.0",
        "core_api": 1,
        "cli_version": "0.1.0",
        "cli_requirement": ">=0.1.0,<0.2.0",
        "model": "gpt-5.6-terra",
        "reasoning_effort": "medium",
        "validated_on": "2026-08-21",
        "scope": [
          "discovery",
          "explicit_invocation",
          "implicit_invocation",
          "dependency_failure_closed",
          "upgrade",
          "recoverable_uninstall",
          "post_uninstall_discovery",
          "author_files_preserved"
        ]
      }
    ],
    "evidence": [
      "docs/validation/2026-08-21-codex-runtime-e2e-completion.md"
    ],
    "note": "Verified only for the exact Codex, Windows, Adapter, Core, CLI, model, and approval scope recorded above. The Adapter remains unreleased."
  },
  "distribution": {
    "install_directory": "project-orrery",
    "files": [
      "README.md",
      "SKILL.md",
      "adapter-manifest.json",
      "agents/openai.yaml",
      "scripts/check_cli_dependency.py",
      "scripts/install_adapter.py"
    ]
  },
  "lifecycle": {
    "default_conflict_policy": "refuse",
    "upgrade_policy": "backup_outside_discovery_root_then_replace_adapter_directory",
    "uninstall_policy": "move_adapter_directory_to_recoverable_trash_outside_discovery_root",
    "target_project_mutation": "none"
  }
